{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Uniac",
  "description": "Build systems at the speed of thought.",
  "colors": {
    "primary": "#C8312D",
    "light": "#E94F37",
    "dark": "#A02420"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F7FAFF",
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "get-started/installation",
              "get-started/login",
              "get-started/your-first-service"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/services",
              "concepts/deployments",
              "concepts/projects",
              "concepts/references",
              "concepts/endpoints",
              "concepts/manifest"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/multi-service",
              "guides/headless"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/overview"
            ]
          },
          {
            "group": "Platform API",
            "pages": [
              "platform-api/overview"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "uniac CLI",
            "pages": [
              "cli/overview",
              "cli/init",
              "cli/plan",
              "cli/link",
              "cli/deploy",
              "cli/status",
              "cli/auth"
            ]
          },
          {
            "group": "Contracts",
            "pages": [
              "cli/output",
              "cli/exit-codes"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://uniac.ai",
          "icon": "gauge"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/uniac-ai/Uniac",
          "icon": "github"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/sdk/overview", "destination": "/" },
    { "source": "/sdk/service", "destination": "/concepts/services" },
    { "source": "/sdk/system", "destination": "/concepts/deployments" },
    { "source": "/sdk/node", "destination": "/concepts/references" },
    { "source": "/sdk/nodespec", "destination": "/concepts/references" },
    { "source": "/sdk/load", "destination": "/concepts/manifest" },
    { "source": "/sdk/exceptions", "destination": "/cli/exit-codes" },
    { "source": "/concepts/nodes", "destination": "/concepts/references" },
    { "source": "/cli/build", "destination": "/cli/deploy" },
    { "source": "/cli/dev", "destination": "/quickstart" },
    { "source": "/cli/install", "destination": "/get-started/installation" }
  ],
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://uniac.ai/pricing"
      },
      {
        "label": "Support",
        "href": "mailto:support@uniac.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://uniac.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/uniac",
      "github": "https://github.com/uniac-ai/Uniac"
    }
  }
}
