{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Uniac",
  "description": "Build systems at the speed of thought.",
  "colors": {
    "primary": "#C8312D",
    "light": "#E94F37",
    "dark": "#A02420"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F7FAFF",
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "get-started/installation",
              "get-started/login",
              "get-started/your-first-service"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/services",
              "concepts/nodes",
              "concepts/manifest",
              "concepts/projects",
              "concepts/deployments",
              "concepts/endpoints"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/overview"
            ]
          },
          {
            "group": "Platform API",
            "pages": [
              "platform-api/overview"
            ]
          }
        ]
      },
      {
        "tab": "SDK Reference",
        "groups": [
          {
            "group": "Python SDK",
            "pages": [
              "sdk/overview",
              "sdk/service",
              "sdk/system",
              "sdk/node",
              "sdk/nodespec",
              "sdk/load",
              "sdk/exceptions"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "uniac CLI",
            "pages": [
              "cli/overview",
              "cli/init",
              "cli/build",
              "cli/install",
              "cli/link",
              "cli/deploy",
              "cli/auth",
              "cli/dev",
              "cli/exit-codes"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://uniac.ai",
          "icon": "gauge"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/uniac-ai/Uniac",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://uniac.ai/pricing"
      },
      {
        "label": "Support",
        "href": "mailto:support@uniac.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://uniac.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/uniac",
      "github": "https://github.com/uniac-ai/Uniac"
    }
  }
}
