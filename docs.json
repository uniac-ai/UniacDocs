{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Uniac",
  "description": "Describe a system in one file; the platform runs it.",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FAFAFA",
    "dark": "#171717"
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 700
    },
    "body": {
      "family": "Space Grotesk",
      "weight": 400
    }
  },
  "background": {
    "color": {
      "light": "#FAF6EF",
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/model",
              "concepts/manifest"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "uniac CLI",
            "pages": [
              "cli/overview"
            ]
          },
          {
            "group": "Contracts",
            "pages": [
              "cli/output",
              "cli/exit-codes"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://uniac.ai",
          "icon": "gauge"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/uniac-ai/Uniac",
          "icon": "github"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/sdk/overview", "destination": "/" },
    { "source": "/sdk/service", "destination": "/concepts/model" },
    { "source": "/sdk/system", "destination": "/concepts/model" },
    { "source": "/sdk/node", "destination": "/concepts/manifest" },
    { "source": "/sdk/nodespec", "destination": "/concepts/manifest" },
    { "source": "/sdk/load", "destination": "/concepts/manifest" },
    { "source": "/sdk/exceptions", "destination": "/cli/exit-codes" },
    { "source": "/concepts/nodes", "destination": "/concepts/manifest" },
    { "source": "/concepts/services", "destination": "/concepts/model" },
    { "source": "/concepts/deployments", "destination": "/concepts/model" },
    { "source": "/concepts/projects", "destination": "/concepts/model" },
    { "source": "/concepts/references", "destination": "/concepts/manifest" },
    { "source": "/concepts/endpoints", "destination": "/concepts/manifest" },
    { "source": "/get-started/installation", "destination": "/quickstart" },
    { "source": "/get-started/login", "destination": "/quickstart" },
    { "source": "/get-started/your-first-service", "destination": "/quickstart" },
    { "source": "/cli/build", "destination": "/cli/overview" },
    { "source": "/cli/dev", "destination": "/quickstart" },
    { "source": "/cli/install", "destination": "/quickstart" },
    { "source": "/cli/init", "destination": "/cli/overview" },
    { "source": "/cli/plan", "destination": "/cli/overview" },
    { "source": "/cli/link", "destination": "/cli/overview" },
    { "source": "/cli/deploy", "destination": "/cli/overview" },
    { "source": "/cli/status", "destination": "/cli/overview" },
    { "source": "/cli/auth", "destination": "/cli/overview" },
    { "source": "/guides/headless", "destination": "/quickstart" },
    { "source": "/guides/agents", "destination": "/quickstart" },
    { "source": "/guides/multi-service", "destination": "/concepts/manifest" },
    { "source": "/dashboard/overview", "destination": "/" },
    { "source": "/platform-api/overview", "destination": "/cli/overview" }
  ],
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://uniac.ai/pricing"
      },
      {
        "label": "Support",
        "href": "mailto:support@uniac.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://uniac.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/uniac",
      "github": "https://github.com/uniac-ai/Uniac"
    }
  }
}
